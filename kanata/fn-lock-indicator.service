[Unit]
Description=Fn-lock LED indicator for Kanata mouse mode
# The mouse daemon is a SYSTEM service. Do not start a second user Kanata.
# The helper retries until the localhost control server becomes available.

[Service]
ExecStart=/usr/bin/python3 %h/.config/kanata/fn-lock-indicator.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
